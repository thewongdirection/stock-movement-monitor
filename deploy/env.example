# Credentials for the monitor. Copy to /opt/stock-movement-monitor/.env and
# chmod 600 — systemd reads it as EnvironmentFile.
#
# This file is gitignored. Never commit real values.

# --- Alert delivery (required) ---------------------------------------------
# @BotFather -> /newbot. Then message your bot once and run
#   monitor telegram-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SEC EDGAR (free, needed for insider alerts) ---------------------------
# SEC's fair-access policy wants an identifier and a contact that reaches you.
SEC_USER_AGENT=stock-movement-monitor you@example.com

# --- Price history (optional) ----------------------------------------------
# Needed by the volume detector and CAN SLIM scorecards when providers.bars is
# `fmp`. The price-history endpoints need FMP's Starter plan or above; a free
# key authenticates and then 403s on exactly those calls.
# Leave empty if you are using IBKR for bars instead.
FMP_API_KEY=

# --- Unusual Whales (optional, paid) ---------------------------------------
# Individual dark pool prints and options flow. Without it, keep dark_pool,
# block_trades and options_flow disabled in config.yaml.
UW_API_KEY=

# --- Claude (optional) ------------------------------------------------------
# Lets an LLM write the CAN SLIM commentary and judge the two letters the
# numbers cannot settle. Needs `pip install -r requirements-narrator.txt`.
ANTHROPIC_API_KEY=

# --- IBKR ------------------------------------------------------------------
# IBKR has NO API key. It talks to a Client Portal Gateway that must be running
# and interactively logged in, with a session that expires roughly daily. Set
# providers.ibkr.base_url in config.yaml (typically https://localhost:5000);
# there is nothing to put here.
