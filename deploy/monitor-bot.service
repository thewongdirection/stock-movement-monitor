# The Telegram bot: long-polling, so it answers /list, /status, /grade and the
# threshold commands. Optional — the timer above sends alerts without it. Run
# this when you want the monitor to be interactive.

[Unit]
Description=Stock movement monitor — Telegram bot
Documentation=https://github.com/thewongdirection/stock-movement-monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/stock-movement-monitor
EnvironmentFile=/opt/stock-movement-monitor/.env
ExecStart=/opt/stock-movement-monitor/.venv/bin/python -m monitor bot
Environment=PYTHONPATH=/opt/stock-movement-monitor/src
Environment=PYTHONUNBUFFERED=1

# Long polling drops connections routinely; that is normal, not a crash.
Restart=always
RestartSec=15
# But if it dies five times in a minute something is actually wrong — stop
# rather than hammering Telegram and getting the token rate-limited.
StartLimitBurst=5
StartLimitIntervalSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/stock-movement-monitor/state
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
